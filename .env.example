# Copy to .env (git-ignored) or set these in your shell / IDE run configuration.
# Never commit real values.

# Backend database
IATROS_DB_URL=jdbc:postgresql://localhost:5432/iatros
IATROS_DB_USERNAME=iatros
IATROS_DB_PASSWORD=

# Backend test database (defaults to the values below if unset)
IATROS_TEST_DB_URL=jdbc:postgresql://localhost:5432/iatros_test
IATROS_TEST_DB_USERNAME=iatros
IATROS_TEST_DB_PASSWORD=

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# dev only: password for the fictional demo accounts (min 8 characters). Leave empty to skip the demo seed.
IATROS_DEMO_PASSWORD=

# Directory for uploaded medical documents (required in prod; dev defaults to ~/.iatros/documents).
# Keep it outside the repository and include it in backups.
IATROS_DOCUMENTS_DIR=

# prod only: outgoing email and the public URL used in email links
IATROS_SMTP_HOST=
IATROS_SMTP_PORT=587
IATROS_SMTP_USERNAME=
IATROS_SMTP_PASSWORD=
IATROS_MAIL_FROM=
IATROS_APP_BASE_URL=
